<?xml version="1.0" encoding="utf-8"?>
<!-- Android-Backup ab Android 12: Anmeldedaten nicht mitsichern, sie sind an dieses Gerät gebunden. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cloud_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cloud_auth.xml" />
    </device-transfer>
</data-extraction-rules>
